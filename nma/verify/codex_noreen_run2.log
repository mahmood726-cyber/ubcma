import csv
from collections import defaultdict
for path in ['nma/reference/smoking_input.csv','nma/reference/senn2013_input.csv']:
    by=defaultdict(list)
    with open(path,newline='') as f:
        for r in csv.DictReader(f):
            by[r['studlab']].append((r['treat1'],r['treat2'],float(r['TE']),float(r['seTE'])))
    print(path)
    print('studies',len(by),'comparisons',sum(len(v) for v in by.values()))
    counts=defaultdict(int)
    arms_counts=defaultdict(int)
    for st, rows in by.items():
        arms=sorted({x for r in rows for x in r[:2]})
        counts[len(rows)] += 1
        arms_counts[len(arms)] += 1
        if len(rows)>1:
            print(st,'arms',arms,'c',len(rows),'pairs',[(a,b) for a,b,_,__ in rows])
    print('comparison count distribution',dict(sorted(counts.items())))
    print('arm count distribution',dict(sorted(arms_counts.items())))
'@ | python -" in F:\ubcma
