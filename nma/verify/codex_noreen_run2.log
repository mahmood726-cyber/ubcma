import csv
from pathlib import Path
from collections import defaultdict
import numpy as np

root=Path('.')

def read_input(path):
    rows=[]
    with open(path,newline='') as f:
        for r in csv.DictReader(f):
            rows.append({'studlab':r['studlab'],'treat1':r['treat1'],'treat2':r['treat2'],'TE':float(r['TE']),'seTE':float(r['seTE'])})
    return rows

def read_scalars(path):
    with open(path,newline='') as f:
        return next(csv.DictReader(f))

def read_matrix(path):
    with open(path,newline='') as f:
        reader=csv.reader(f)
        header=next(reader)[1:]
        mat=[]; rows=[]
        for row in reader:
            rows.append(row[0]); mat.append([float(x) for x in row[1:]])
    assert header==rows
    return header,np.array(mat,float)

def covariance_block(study_rows, tau2):
    arms=sorted({r['treat1'] for r in study_rows} | {r['treat2'] for r in study_rows})
    ai={a:i for i,a in enumerate(arms)}
    c=len(study_rows); p=len(arms)
    A=np.zeros((c,p))
    for k,r in enumerate(study_rows):
        A[k,ai[r['treat1']]]=1
        A[k,ai[r['treat2']]]=-1
    if p==2 and c==1:
        V=np.array([[study_rows[0]['seTE']**2 + tau2]])
        return V
    # solve v = C sigma2 where C has endpoint indicators
    C=np.zeros((c,p))
    v=np.zeros(c)
    for k,r in enumerate(study_rows):
        C[k,ai[r['treat1']]]=1
        C[k,ai[r['treat2']]]=1
        v[k]=r['seTE']**2
    sig2=np.linalg.lstsq(C,v,rcond=None)[0]
    # print(arms,sig2)
    V=A @ np.diag(sig2 + tau2/2.0) @ A.T
    return V

def nma(rows,treats,tau2):
    m=len(rows); n=len(treats); ti={t:i for i,t in enumerate(treats)}
    B=np.zeros((m,n)); y=np.zeros(m)
    by=defaultdict(list)
    for idx,r in enumerate(rows):
        B[idx,ti[r['treat1']]]=1
        B[idx,ti[r['treat2']]]=-1
        y[idx]=r['TE']
        by[r['studlab']].append((idx,r))
    W=np.zeros((m,m))
    for st, pairs in by.items():
        idxs=[i for i,r in pairs]
        srows=[r for i,r in pairs]
        V=covariance_block(srows,tau2)
        Wb=np.linalg.pinv(V, rcond=1e-12)
        for a,i in enumerate(idxs):
            for b,j in enumerate(idxs):
                W[i,j]=Wb[a,b]
    L=B.T@W@B
    Lp=np.linalg.pinv(L,rcond=1e-12)
    theta=Lp @ B.T @ W @ y
    TE=theta[:,None]-theta[None,:]
    SE=np.zeros((n,n))
    for i in range(n):
        for j in range(n):
            var=Lp[i,i]+Lp[j,j]-2*Lp[i,j]
            SE[i,j]=np.sqrt(max(var,0))
    return TE,SE,theta,Lp

for tag in ['smoking','senn2013']:
    rows=read_input(root/f'nma/reference/{tag}_input.csv')
    scal=read_scalars(root/f'nma/reference/{tag}_scalars.csv')
    tau2=float(scal['tau2'])
    treats, refTE=read_matrix(root/f'nma/reference/{tag}_TE_random.csv')
    treats2, refSE=read_matrix(root/f'nma/reference/{tag}_seTE_random.csv')
    assert treats==treats2
    TE,SE,theta,Lp=nma(rows,treats,tau2)
    print(tag, 'tau2', tau2)
    print('TE max', np.max(np.abs(TE-refTE)), 'SE max', np.max(np.abs(SE-refSE)))
    for name, M, R in [('TE',TE,refTE),('SE',SE,refSE)]:
        D=np.abs(M-R)
        ind=np.unravel_index(np.argmax(D),D.shape)
        print(name, treats[ind[0]], treats[ind[1]], M[ind], R[ind], M[ind]-R[ind])
