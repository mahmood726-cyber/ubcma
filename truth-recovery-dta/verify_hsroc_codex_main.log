+        self.k = int(self.tp.size)
+
+        if not (self.fp.size == self.fn.size == self.tn.size == self.k):
+            raise ValueError("Count arrays must have the same length")
+
+        n1 = self.tp + self.fn
+        n0 = self.tn + self.fp
+        self.log_choose = (
+            gammaln(n1 + 1.0)
+            - gammaln(self.tp + 1.0)
+            - gammaln(self.fn + 1.0)
+            + gammaln(n0 + 1.0)
+            - gammaln(self.tn + 1.0)
+            - gammaln(self.fp + 1.0)
+        )
+
+        gh_x, gh_w = roots_hermite(nodes)
+        z = math.sqrt(2.0) * gh_x
