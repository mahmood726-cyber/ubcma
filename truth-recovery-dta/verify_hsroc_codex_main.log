+    }
+
+    serialized = json.dumps(result, indent=2, sort_keys=True)
+    if os.environ.get("VERIFY_HSROC_STDOUT_ONLY") == "1":
+        print(serialized)
+        return
+
+    with RESULT_PATH.open("w", encoding="utf-8", newline="\n") as f:
+        f.write(serialized)
