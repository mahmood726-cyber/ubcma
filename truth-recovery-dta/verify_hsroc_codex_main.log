+    unique: list[np.ndarray] = []
+    seen = set()
+    for start in starts:
+        clipped = np.array([np.clip(v, lo, hi) for v, (lo, hi) in zip(start, OPT_BOUNDS)], dtype=float)
+        key = tuple(np.round(clipped, 8))
+        if key not in seen:
