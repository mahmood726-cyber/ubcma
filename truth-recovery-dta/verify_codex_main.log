+    for row, diag in zip(y, s_diag):
+        v11 = sigma[0, 0] + diag[0]
+        v22 = sigma[1, 1] + diag[1]
+        v12 = sigma[0, 1]
+        det = v11 * v22 - v12 * v12
+        diff = row - mean
+        quad += (v22 * diff[0] * diff[0] - 2.0 * v12 * diff[0] * diff[1] + v11 * diff[1] * diff[1]) / det
+
+    return 0.5 * (logdet_sum + quad)
