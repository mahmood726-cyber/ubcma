+import json
+from math import pi
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+SEAT = "codex_pc2"
+INPUT_CSV = Path("dta_focus_perrep.csv")
+OUTPUT_JSON = Path(f"verify_rederive_{SEAT}_result.json")
+TARGETS = [
+    ("k10_hi", "strong"),
+    ("k6_thr", "strong"),
+    ("k10_thr", "strong"),
+    ("k20_thr", "strong"),
+]
+REF_METHOD = "reitsma"
+TEST_METHOD = "adaptshrink_dta"
+N_BOOT = 2000
+BOOT_SEED = 20260630
+
+
+def mciw_area(errors: np.ndarray) -> float:
+    """MCIW0-2D constant-region AREA for an n x 2 error matrix."""
+    errors = np.asarray(errors, dtype=float)
+    if errors.ndim != 2 or errors.shape[1] != 2:
+        raise ValueError(f"expected n x 2 errors, got shape {errors.shape}")
+    if errors.shape[0] < 2:
+        raise ValueError("at least two paired replicates are required")
+
+    w = np.cov(errors, rowvar=False)
+    det_w = float(np.linalg.det(w))
+    if not np.isfinite(det_w) or det_w <= 0:
+        raise ValueError(f"non-positive covariance determinant: {det_w}")
+
+    inv_w = np.linalg.inv(w)
+    d2 = np.einsum("ij,jk,ik->i", errors, inv_w, errors)
+    q = float(np.quantile(d2, 0.95))
+    return float(pi * q * np.sqrt(det_w))
+
+
+def paired_errors(df: pd.DataFrame, cell: str, strength: str) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    subset = df[
+        (df["cell"] == cell)
+        & (df["strength"] == strength)
+        & (df["method"].isin([REF_METHOD, TEST_METHOD]))
+    ].copy()
+
+    if subset.empty:
+        raise ValueError(f"no rows found for {cell}/{strength}")
+
+    finite_cols = ["true_m1", "true_m2", "m1", "m2"]
+    subset = subset[subset["converged"].astype(bool)]
+    subset = subset[np.isfinite(subset[finite_cols].to_numpy(dtype=float)).all(axis=1)]
+
+    ref_reps = set(subset.loc[subset["method"] == REF_METHOD, "rep"])
+    test_reps = set(subset.loc[subset["method"] == TEST_METHOD, "rep"])
+    paired_reps = np.array(sorted(ref_reps & test_reps))
+    if paired_reps.size == 0:
+        raise ValueError(f"no paired replicates found for {cell}/{strength}")
+
+    errors = {}
+    for method in [REF_METHOD, TEST_METHOD]:
+        rows = (
+            subset[(subset["method"] == method) & (subset["rep"].isin(paired_reps))]
+            .sort_values("rep")
+            .drop_duplicates("rep", keep="first")
+        )
+        if len(rows) != len(paired_reps):
+            raise ValueError(f"missing paired rows for {cell}/{strength}/{method}")
+        if not np.array_equal(rows["rep"].to_numpy(), paired_reps):
+            raise ValueError(f"replicate alignment failed for {cell}/{strength}/{method}")
+        errors[method] = rows[["m1", "m2"]].to_numpy(dtype=float) - rows[
+            ["true_m1", "true_m2"]
+        ].to_numpy(dtype=float)
+
+    return paired_reps, errors[REF_METHOD], errors[TEST_METHOD]
+
+
+def summarize_cell(
+    df: pd.DataFrame,
+    cell: str,
+    strength: str,
+    rng: np.random.Generator,
+    n_boot: int = N_BOOT,
+) -> dict:
+    paired_reps, ref_errors, test_errors = paired_errors(df, cell, strength)
+
+    area_ref = mciw_area(ref_errors)
+    area_test = mciw_area(test_errors)
+    darea = area_test - area_ref
+
+    n_reps = len(paired_reps)
+    boot_diffs = np.empty(n_boot, dtype=float)
+    for b in range(n_boot):
+        idx = rng.integers(0, n_reps, size=n_reps)
+        boot_diffs[b] = mciw_area(test_errors[idx]) - mciw_area(ref_errors[idx])
+
+    ci_lo, ci_hi = np.quantile(boot_diffs, [0.025, 0.975])
+    return {
+        "cell": cell,
+        "strength": strength,
+        "area_reitsma": area_ref,
+        "area_adaptshrink": area_test,
+        "darea": darea,
+        "ci_lo": float(ci_lo),
+        "ci_hi": float(ci_hi),
+        "frac_better": float(np.mean(boot_diffs < 0)),
+        "robust_win": bool(ci_hi < 0),
+        "n_reps": int(n_reps),
+    }
+
+
+def main() -> None:
+    df = pd.read_csv(INPUT_CSV)
+    rng = np.random.default_rng(BOOT_SEED)
+    cells = [summarize_cell(df, cell, strength, rng) for cell, strength in TARGETS]
+
+    result = {"seat": SEAT, "cells": cells, "imported_ubcma": False}
+    OUTPUT_JSON.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+
+    table = pd.DataFrame(cells)[
+        [
+            "cell",
+            "strength",
+            "n_reps",
+            "area_reitsma",
+            "area_adaptshrink",
+            "darea",
+            "ci_lo",
+            "ci_hi",
+            "frac_better",
+            "robust_win",
+        ]
+    ]
+    print(table.to_string(index=False, float_format=lambda x: f"{x:.6f}"))
+
+
+if __name__ == "__main__":
+    main()

